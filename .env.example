# Copy to .env and change the values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost
# When DJANGO_DEBUG=0: cookies are HTTPS-only and plain HTTP is redirected.
# Set DJANGO_HSTS_SECONDS=31536000 once a trusted certificate is in place.
DJANGO_SESSION_MINUTES=30
DJANGO_HSTS_SECONDS=0
DB_NAME=sams
DB_USER=sams
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-too
SEED_PASSWORD=Sams@12345
TLS_DOMAIN=localhost
TLS_DAYS=365
